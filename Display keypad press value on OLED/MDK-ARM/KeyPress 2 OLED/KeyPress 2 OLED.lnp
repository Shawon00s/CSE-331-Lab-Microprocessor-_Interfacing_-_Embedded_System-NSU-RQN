--cpu Cortex-M3
"keypress 2 oled\startup_stm32f103xb.o"
"keypress 2 oled\fonts.o"
"keypress 2 oled\ssd1306.o"
"keypress 2 oled\main.o"
"keypress 2 oled\stm32f1xx_it.o"
"keypress 2 oled\stm32f1xx_hal_msp.o"
"keypress 2 oled\stm32f1xx_hal_gpio_ex.o"
"keypress 2 oled\stm32f1xx_hal_i2c.o"
"keypress 2 oled\stm32f1xx_hal.o"
"keypress 2 oled\stm32f1xx_hal_rcc.o"
"keypress 2 oled\stm32f1xx_hal_rcc_ex.o"
"keypress 2 oled\stm32f1xx_hal_gpio.o"
"keypress 2 oled\stm32f1xx_hal_dma.o"
"keypress 2 oled\stm32f1xx_hal_cortex.o"
"keypress 2 oled\stm32f1xx_hal_pwr.o"
"keypress 2 oled\stm32f1xx_hal_flash.o"
"keypress 2 oled\stm32f1xx_hal_flash_ex.o"
"keypress 2 oled\stm32f1xx_hal_exti.o"
"keypress 2 oled\system_stm32f1xx.o"
--strict --scatter "KeyPress 2 OLED\KeyPress 2 OLED.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "KeyPress 2 OLED.map" -o "KeyPress 2 OLED\KeyPress 2 OLED.axf"