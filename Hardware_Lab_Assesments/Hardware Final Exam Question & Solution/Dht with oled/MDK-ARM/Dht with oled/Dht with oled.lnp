--cpu Cortex-M3
"dht with oled\startup_stm32f103xb.o"
"dht with oled\fonts.o"
"dht with oled\ssd1306.o"
"dht with oled\main.o"
"dht with oled\stm32f1xx_it.o"
"dht with oled\stm32f1xx_hal_msp.o"
"dht with oled\stm32f1xx_hal_gpio_ex.o"
"dht with oled\stm32f1xx_hal_i2c.o"
"dht with oled\stm32f1xx_hal.o"
"dht with oled\stm32f1xx_hal_rcc.o"
"dht with oled\stm32f1xx_hal_rcc_ex.o"
"dht with oled\stm32f1xx_hal_gpio.o"
"dht with oled\stm32f1xx_hal_dma.o"
"dht with oled\stm32f1xx_hal_cortex.o"
"dht with oled\stm32f1xx_hal_pwr.o"
"dht with oled\stm32f1xx_hal_flash.o"
"dht with oled\stm32f1xx_hal_flash_ex.o"
"dht with oled\stm32f1xx_hal_exti.o"
"dht with oled\stm32f1xx_hal_tim.o"
"dht with oled\stm32f1xx_hal_tim_ex.o"
"dht with oled\system_stm32f1xx.o"
--strict --scatter "Dht with oled\Dht with oled.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "Dht with oled.map" -o "Dht with oled\Dht with oled.axf"